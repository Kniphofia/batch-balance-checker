# Target EVM network RPC endpoint (used by deploy and query scripts)
RPC_URL=https://your-evm-rpc-endpoint

# Required only for contract deployment (account must have native coins for gas). Do NOT commit real private keys.
PRIVATE_KEY=

# Deployed BatchBalanceChecker contract address (required by query script)
BALANCE_CONTRACT=

# Query configuration
OWNER=
# Comma-separated addresses; 'native', '0x0', or full zero address represents native currency
ASSETS=native,0x0000000000000000000000000000000000000000
NATIVE_SYMBOL=Native
# 'latest' or a specific block number to pin query height
BLOCK_TAG=latest
